<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ECEFF1"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/btnLang"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_3d_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingHorizontal="12dp"
            android:text="@string/mode_sinhala"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFix"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_3d_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingHorizontal="12dp"
            android:text="@string/key_fix"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnTonePro"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/suggestion_chip_primary_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="@string/tone_professional"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnToneFriendly"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/suggestion_chip_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="@string/tone_friendly"
            android:textColor="#1B5E20"
            android:textSize="12sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/suggestionRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_3d_mic_light"
            android:clickable="true"
            android:contentDescription="@string/key_mic"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

    <include
        android:id="@+id/emojiPanel"
        layout="@layout/emoji_panel" />

    <LinearLayout
        android:id="@+id/keyboardKeysPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/KeyboardRow">
            <TextView android:id="@+id/keyQ" style="@style/KeyText" android:text="q" />
            <TextView android:id="@+id/keyW" style="@style/KeyText" android:text="w" />
            <TextView android:id="@+id/keyE" style="@style/KeyText" android:text="e" />
            <TextView android:id="@+id/keyR" style="@style/KeyText" android:text="r" />
            <TextView android:id="@+id/keyT" style="@style/KeyText" android:text="t" />
            <TextView android:id="@+id/keyY" style="@style/KeyText" android:text="y" />
            <TextView android:id="@+id/keyU" style="@style/KeyText" android:text="u" />
            <TextView android:id="@+id/keyI" style="@style/KeyText" android:text="i" />
            <TextView android:id="@+id/keyO" style="@style/KeyText" android:text="o" />
            <TextView android:id="@+id/keyP" style="@style/KeyText" android:text="p" />
        </LinearLayout>

        <LinearLayout style="@style/KeyboardRow">
            <TextView android:id="@+id/keyA" style="@style/KeyText" android:text="a" />
            <TextView android:id="@+id/keyS" style="@style/KeyText" android:text="s" />
            <TextView android:id="@+id/keyD" style="@style/KeyText" android:text="d" />
            <TextView android:id="@+id/keyF" style="@style/KeyText" android:text="f" />
            <TextView android:id="@+id/keyG" style="@style/KeyText" android:text="g" />
            <TextView android:id="@+id/keyH" style="@style/KeyText" android:text="h" />
            <TextView android:id="@+id/keyJ" style="@style/KeyText" android:text="j" />
            <TextView android:id="@+id/keyK" style="@style/KeyText" android:text="k" />
            <TextView android:id="@+id/keyL" style="@style/KeyText" android:text="l" />
        </LinearLayout>

        <LinearLayout style="@style/KeyboardRow">
            <TextView android:id="@+id/keyShift" style="@style/KeyTextWide" android:text="⇧" />
            <TextView android:id="@+id/keyZ" style="@style/KeyText" android:text="z" />
            <TextView android:id="@+id/keyX" style="@style/KeyText" android:text="x" />
            <TextView android:id="@+id/keyC" style="@style/KeyText" android:text="c" />
            <TextView android:id="@+id/keyV" style="@style/KeyText" android:text="v" />
            <TextView android:id="@+id/keyB" style="@style/KeyText" android:text="b" />
            <TextView android:id="@+id/keyN" style="@style/KeyText" android:text="n" />
            <TextView android:id="@+id/keyM" style="@style/KeyText" android:text="m" />
            <TextView android:id="@+id/keyBackspace" style="@style/KeyTextWide" android:text="⌫" />
        </LinearLayout>

        <LinearLayout style="@style/KeyboardRow">
            <TextView android:id="@+id/keyNumbers" style="@style/KeyTextWide" android:text="123" />
            <TextView android:id="@+id/keyComma" style="@style/KeyText" android:text="," />
            <TextView android:id="@+id/keySpace" style="@style/KeyTextSpace" android:text="space" />
            <TextView android:id="@+id/keyPeriod" style="@style/KeyText" android:text="." />
            <TextView android:id="@+id/keyEnter" style="@style/KeyTextWide" android:text="↵" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
