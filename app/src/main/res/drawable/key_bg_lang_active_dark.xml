<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A2E0E" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1B5E20"
                android:startColor="#388E3C" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#2E7D32" />
        </shape>
    </item>
</layer-list>
